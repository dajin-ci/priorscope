# .env.example
# 이 파일을 .env로 복사한 뒤 값을 채운다. 실제 값은 .env에만 넣는다.

UPSTAGE_API_KEY=
UPSTAGE_PROJECT_ID=

MY_PAPER_AGENT_ID=
MY_PAPER_CONFIG_ID=

PRIOR_PAPER_AGENT_ID=
PRIOR_PAPER_CONFIG_ID=

COMPARE_AGENT_ID=
COMPARE_CONFIG_ID=

# 적합성 분류 (같은 Upstage API 키 사용)
SUITABILITY_MODEL=solar-pro4

# Compare Agent 반복 실행 횟수 (판정 합치기). 기본 3
COMPARE_RUNS=3
SUITABILITY_RUNS=3
